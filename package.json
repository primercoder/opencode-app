{
  "name": "ocremote",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/host",
    "apps/mobile"
  ],
  "scripts": {
    "test": "bun run --cwd packages/protocol test && bun run --cwd apps/host test && bun run --cwd apps/mobile test",
    "test:protocol": "bun test packages/protocol",
    "typecheck": "tsc -p tsconfig.json --noEmit && bun run --cwd apps/mobile typecheck",
    "host": "bun run --cwd apps/host src/index.ts",
    "env:check": "bash scripts/check-env.sh",
    "env:bench": "bash scripts/bench-network.sh",
    "test:relay": "cd apps/relay && go test ./...",
    "smoke:opencode": "bun run scripts/ocremote-smoke.ts",
    "models:fetch": "bash scripts/fetch-dev-models.sh",
    "models:serve": "bun run scripts/model-server.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^5.9.2"
  }
}
